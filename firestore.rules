rules_version = '2';

// Security Rules do Firestore do Arena Football.
// Deploy: firebase deploy --only firestore:rules --project arenasoccerflutter
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Dono de time ("Sou dono de time"): o pedido aprovado em
    // `solicitacoes_time/{uid}` diz o time (`idTime`, e o `nome` como cópia);
    // null = não é dono.
    function ownedTeam() {
      let path = /databases/$(database)/documents/solicitacoes_time/$(request.auth.uid);
      return signedIn() && exists(path) && get(path).data.status == 'aprovada' ? get(path).data : null;
    }

    // Parceiro ("Sou parceiro"): o pedido aprovado em `solicitacoes_parceiro/{uid}`
    // traz a região (`idRegiao`) e as permissões (podeNoticias, podeDestaques,
    // podePublicidade, limiteDestaques, limitePublicidadeDia); null = não é.
    function partner() {
      let path = /databases/$(database)/documents/solicitacoes_parceiro/$(request.auth.uid);
      return signedIn() && exists(path) && get(path).data.status == 'aprovada' ? get(path).data : null;
    }

    // O doc (jogador ou pedido "Sou jogador") é do time do dono? Pelo id
    // (`idTime`) quando os dois lados têm; doc antigo, sem id, pelo nome (`time`).
    // Atleta inscrito no time em alguma competição (`idsTimes`) também conta.
    function ownsTeam(data) {
      let owned = ownedTeam();
      let id = data.get('idTime', '');
      let ownedId = owned == null ? '' : owned.get('idTime', '');
      return owned != null && ((id != '' && ownedId != ''
        ? id == ownedId
        : data.get('time', '') != '' && data.get('time', '') == owned.nome)
        || (ownedId != '' && data.get('idsTimes', []).hasAny([ownedId])));
    }

    // Doc sem time (atleta tirado do elenco).
    function noTeam(data) {
      return data.get('time', '') == '' && data.get('idTime', '') == '';
    }

    // Admin = flag `admin` no próprio documento de `usuarios/{uid}`.
    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.admin == true;
    }

    // Perfil: só o dono (ou admin) lê. O dono cria e edita o próprio perfil,
    // mas nunca consegue se promover a admin nem trocar o idUsuario.
    match /usuarios/{userId} {
      // `userId == uid` vem antes: permite o get() do próprio doc mesmo quando
      // ele ainda não existe (recuperação de conta órfã no login).
      // `resource.data.idUsuario` cobre contas antigas com id de doc diferente do uid.
      function isOwner() {
        return signedIn() && (userId == request.auth.uid || resource.data.idUsuario == request.auth.uid);
      }

      // Troca do time do coração (sai de um time para outro): pelo id e, em
      // doc antigo sem id, pelo nome. A primeira escolha não é troca.
      function teamSwitch() {
        let oldId = resource.data.get('idTime', '');
        let oldName = resource.data.get('time', '');
        return (oldId != '' && request.resource.data.get('idTime', '') != oldId)
          || (oldId == '' && oldName != '' && request.resource.data.get('time', '') != oldName);
      }
      // `trocaTimeEm` só pode ser a hora do servidor (nunca uma data inventada).
      function honestStamp() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['trocaTimeEm'])
          || request.resource.data.trocaTimeEm == request.time;
      }
      // Uma troca a cada 15 dias, carimbada em `trocaTimeEm`.
      function teamSwitchAllowed() {
        return !teamSwitch()
          || (request.resource.data.get('trocaTimeEm', null) == request.time
            && (resource.data.get('trocaTimeEm', null) == null
              || request.time >= resource.data.trocaTimeEm + duration.value(15, 'd')));
      }

      allow read: if isOwner() || isAdmin();
      allow create: if signedIn()
        && userId == request.auth.uid
        && request.resource.data.idUsuario == request.auth.uid
        && request.resource.data.admin == false
        && !('trocaTimeEm' in request.resource.data);
      allow update: if isOwner()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['admin', 'idUsuario'])
        && honestStamp()
        && teamSwitchAllowed();
      allow delete: if isOwner();
    }

    // Conquistas: contadores do usuário. O app só grava os campos dele, sempre
    // +1 (compartilhar, ler notícia) ou o dia de uso (um por dia de Brasília,
    // pela hora do servidor); os outros (votos, atleta...) só as Cloud Functions.
    match /usuarios/{userId}/progresso/contadores {
      function own() {
        return signedIn() && userId == request.auth.uid;
      }
      function num(data, key) {
        return key in data ? data[key] : 0;
      }
      function before(key) {
        return resource == null ? 0 : num(resource.data, key);
      }
      function after(key) {
        return num(request.resource.data, key);
      }
      function plusOne(key) {
        return after(key) == before(key) + 1;
      }
      function day(moment) {
        return (moment - duration.value(3, 'h')).date();
      }
      function firstVisit() {
        return resource == null || !('ultimoAcesso' in resource.data);
      }
      function visitOk() {
        let seq = after('sequenciaDias');
        let best = before('melhorSequencia');
        return request.resource.data.ultimoAcesso == request.time
          && plusOne('diasAtivos')
          && (firstVisit() || day(request.time) > day(resource.data.ultimoAcesso))
          && (seq == 1 || (!firstVisit()
            && day(request.time) == day(resource.data.ultimoAcesso) + duration.value(1, 'd')
            && seq == before('sequenciaDias') + 1))
          && after('melhorSequencia') == (seq > best ? seq : best);
      }
      function appChange(keys) {
        return (keys.hasOnly(['compartilhamentos']) && plusOne('compartilhamentos'))
          || (keys.hasOnly(['noticiasLidas']) && plusOne('noticiasLidas'))
          || (keys.hasOnly(['diasAtivos', 'sequenciaDias', 'melhorSequencia', 'ultimoAcesso']) && visitOk());
      }

      allow read: if own() || isAdmin();
      allow create: if own() && appChange(request.resource.data.keys());
      allow update: if own() && appChange(request.resource.data.diff(resource.data).affectedKeys());
    }

    // Conquistas desbloqueadas: gravadas pelas Cloud Functions; o dono lê e
    // só marca que viu a comemoração.
    match /usuarios/{userId}/conquistas/{achievementId} {
      allow read: if signedIn() && (userId == request.auth.uid || isAdmin());
      allow update: if signedIn() && userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vista'])
        && request.resource.data.vista == true;
    }

    // Conteúdo do app: noticias, destaques, competicao, campeonatos,
    // times{ano}, jogadores{ano}, partidas{ano}, classificacao{ano}, grupos{ano},
    // tabelas{ano} (gravadas pelas functions) e os votos antigos melhorjogador{timeC}{timeF} (os novos ficam em
    // partidas{ano}/{id}/votos, regra abaixo).
    // Leitura pública (inclui o modo convidado); escrita do admin.
    // Exceções:
    // - cada usuário logado grava/atualiza só o próprio voto (doc id = uid);
    // - o dono de time cadastra, edita e tira jogadores do próprio elenco
    //   (time antes e depois = o dele, pelo `idTime` ou, em doc antigo, pelo
    //   nome em `time`; ou sem time ao tirar do elenco) e troca
    //   só escudo/descrição/cores do próprio time (`idDono` = uid);
    // - o parceiro publica notícias, destaques e publicidade na região dele
    //   (`idAutor` = uid), dentro das permissões, e mexe só no que é dele. Os
    //   limites são as vagas: destaque `dest<n>_<uid>` (n < limiteDestaques),
    //   publicidade `pub<n>_<uid>_<a>-<m>-<d>` (n < limitePublicidadeDia) e notícia
    //   `not<n>_<uid>_<a>-<m>-<d>` (n < limiteNoticiasDia, padrão 3), com a data de
    //   hoje em Brasília; ver `PartnerSlots` no app. Passou do limite de notícias,
    //   ela vai para `noticias_pendentes` (regra abaixo) e o admin aprova.
    match /{collection}/{docId} {
      function writable() {
        return !(collection in ['config', 'notificacoes_envios', 'push_avisos', 'solicitacoes_jogador',
          'solicitacoes_time', 'solicitacoes_parceiro', 'noticias_pendentes', 'album_pacotes']);
      }

      // Dia de hoje em Brasília (UTC-3), igual ao `PartnerSlots.brasiliaDay`.
      function brasiliaDay() {
        let now = request.time - duration.value(3, 'h');
        return string(now.year()) + '-' + string(now.month()) + '-' + string(now.day());
      }

      // Número da vaga no id do doc (`dest1_...` → 1). Só chamar depois do `matches`.
      function slotNumber(prefix) {
        return int(docId.split('_')[0].replace(prefix, ''));
      }

      function adSlot(p) {
        return docId.matches('pub[0-9]_.+') && slotNumber('pub') < p.get('limitePublicidadeDia', 1)
          && docId == 'pub' + string(slotNumber('pub')) + '_' + request.auth.uid + '_' + brasiliaDay();
      }

      function newsSlot(p) {
        return docId.matches('not[0-9]_.+') && slotNumber('not') < p.get('limiteNoticiasDia', 3)
          && docId == 'not' + string(slotNumber('not')) + '_' + request.auth.uid + '_' + brasiliaDay();
      }

      function highlightSlot(p) {
        return docId.matches('dest[0-9]_' + request.auth.uid) && slotNumber('dest') < p.get('limiteDestaques', 2);
      }

      // Notícia/publicidade do parceiro: dele, na região dele, sem os campos de
      // gol/resultado e sem as tags reservadas.
      function partnerNews(data, p) {
        let tag = data.get('tag', '');
        return collection == 'noticias'
          && data.get('idAutor', '') == request.auth.uid
          && data.get('idRegiao', '') == p.get('idRegiao', '-')
          && data.keys().hasOnly(['id', 'data', 'titulo', 'descricao', 'urlImagem', 'link', 'exibir',
            'fk_competicao', 'idRegiao', 'time_casa', 'time_fora', 'gol_time_casa', 'gol_time_fora', 'tag',
            'images', 'idAutor'])
          && (tag == 'publicidade'
            ? p.get('podePublicidade', true)
            : p.get('podeNoticias', true) && !(tag in ['gol', 'resultado', 'votacao']));
      }

      function partnerHighlight(data, p) {
        return collection == 'destaques'
          && p.get('podeDestaques', true)
          && data.get('idAutor', '') == request.auth.uid
          && data.get('idRegiao', '') == p.get('idRegiao', '-')
          && data.keys().hasOnly(['id', 'title', 'link', 'urlImagem', 'exibir', 'priority', 'regiao', 'idRegiao',
            'idAutor']);
      }

      // Marcador da vaga do dia (`vagas_parceiro/{id}`): gravado no mesmo lote da
      // notícia/publicidade e nunca apagado pelo parceiro; vaga com marcador =
      // usada, mesmo que a publicação seja apagada.
      function markerPath() {
        return /databases/$(database)/documents/vagas_parceiro/$(docId);
      }

      function daySlot(p) {
        return docId.matches('pub[0-9]_.+') ? adSlot(p) : newsSlot(p);
      }

      function partnerCreate() {
        let p = partner();
        let data = request.resource.data;
        return p != null
          && ((partnerNews(data, p) && (data.get('tag', '') == 'publicidade' ? adSlot(p) : newsSlot(p))
              && !exists(markerPath()) && existsAfter(markerPath()))
            || (collection == 'vagas_parceiro' && daySlot(p)
              && request.resource.data.keys().hasOnly(['idAutor', 'criadoEm'])
              && request.resource.data.idAutor == request.auth.uid
              && existsAfter(/databases/$(database)/documents/noticias/$(docId)))
            || (partnerHighlight(data, p) && highlightSlot(p) && data.get('priority', '') == '900'));
      }

      // Edita só o que é dele; a publicidade continua publicidade (a vaga) e o
      // destaque não muda de posição (só o admin reordena).
      function partnerUpdate() {
        let p = partner();
        let data = request.resource.data;
        return p != null && resource.data.get('idAutor', '') == request.auth.uid
          && ((partnerNews(data, p)
              && (data.get('tag', '') == 'publicidade') == (resource.data.get('tag', '') == 'publicidade'))
            || (partnerHighlight(data, p) && data.get('priority', '') == resource.data.get('priority', '')));
      }

      function partnerDelete() {
        return collection in ['noticias', 'destaques'] && partner() != null
          && resource.data.get('idAutor', '') == request.auth.uid;
      }

      function isOwnVote() {
        return collection.matches('melhorjogador.*') && signedIn() && docId == request.auth.uid;
      }

      function isPlayers() {
        return collection.matches('jogadores([0-9]{4})?');
      }

      function isTeamDoc() {
        return collection.matches('(times|classificacao)([0-9]{4})?');
      }

      allow read: if !(collection in ['usuarios', 'config', 'notificacoes_envios', 'push_avisos', 'solicitacoes_jogador',
        'solicitacoes_time', 'solicitacoes_parceiro', 'noticias_pendentes', 'manutencao', 'album_pacotes']);
      allow create: if writable() && (isAdmin() || isOwnVote()
        || (isPlayers() && ownsTeam(request.resource.data))
        || partnerCreate());
      // As inscrições por competição nunca somem do atleta (o app antigo
      // regravava o documento inteiro sem elas): esvaziar pode, apagar não.
      function keepsEnrollments() {
        return !isPlayers() || !('inscricoes' in resource.data) || 'inscricoes' in request.resource.data;
      }

      // Dono aprova o "Sou jogador" de quem já é atleta de outro time (outra
      // competição): só acrescenta a inscrição no time dele, e só se o pedido
      // da conta é para o time dele. O time principal só muda se estava vazio.
      // Um time por competição: só a inscrição da competição do pedido muda, e
      // só se ainda não existia ou já era do time do dono.
      function joinsOwnedTeam() {
        let owned = ownedTeam();
        let uid = resource.data.get('idUsuario', '');
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let req = get(/databases/$(database)/documents/solicitacoes_jogador/$(uid)).data;
        return owned != null && uid != '' && ownsTeam(request.resource.data)
          && changed.hasOnly(['inscricoes', 'idsTimes', 'nome', 'posicao', 'urlImagem', 'time', 'idTime'])
          && (!changed.hasAny(['time', 'idTime']) || noTeam(resource.data))
          && req.get('idTime', '') == owned.get('idTime', '-')
          && onlyRequestEnrollment(req, owned);
      }

      function onlyRequestEnrollment(req, owned) {
        let before = resource.data.get('inscricoes', {});
        let after = request.resource.data.get('inscricoes', {});
        let key = 'c' + string(req.get('idCampeonato', -1));
        return after.diff(before).affectedKeys().hasOnly([key])
          && (!(key in before) || before[key].get('idTime', '') == owned.get('idTime', '-'));
      }

      // Dono editando o atleta do elenco dele: só as inscrições do próprio
      // time mudam (a de outro time, noutra competição, fica como está) e a
      // nova é do time dele. As regras não têm laço: até 8 inscrições.
      function ownEnrollmentsOnly() {
        let owned = ownedTeam();
        let id = owned == null ? '-' : owned.get('idTime', '-');
        let before = resource.data.get('inscricoes', {});
        let after = request.resource.data.get('inscricoes', {});
        let changed = after.diff(before).affectedKeys();
        let old = before.keys();
        let now = after.keys();
        return changed.size() == 0 || (old.size() <= 8 && now.size() <= 8
          && (old.size() < 1 || keepsOther(old[0], before, after, changed, id))
          && (old.size() < 2 || keepsOther(old[1], before, after, changed, id))
          && (old.size() < 3 || keepsOther(old[2], before, after, changed, id))
          && (old.size() < 4 || keepsOther(old[3], before, after, changed, id))
          && (old.size() < 5 || keepsOther(old[4], before, after, changed, id))
          && (old.size() < 6 || keepsOther(old[5], before, after, changed, id))
          && (old.size() < 7 || keepsOther(old[6], before, after, changed, id))
          && (old.size() < 8 || keepsOther(old[7], before, after, changed, id))
          && (now.size() < 1 || addsOwn(now[0], before, after, id))
          && (now.size() < 2 || addsOwn(now[1], before, after, id))
          && (now.size() < 3 || addsOwn(now[2], before, after, id))
          && (now.size() < 4 || addsOwn(now[3], before, after, id))
          && (now.size() < 5 || addsOwn(now[4], before, after, id))
          && (now.size() < 6 || addsOwn(now[5], before, after, id))
          && (now.size() < 7 || addsOwn(now[6], before, after, id))
          && (now.size() < 8 || addsOwn(now[7], before, after, id)));
      }

      // Inscrição que já existia: se é de outro time, não muda.
      function keepsOther(key, before, after, changed, id) {
        return !(key in changed) || (before[key].get('idTime', '') == id
          && (!(key in after) || after[key].get('idTime', '') == id));
      }

      // Inscrição nova: só pelo time do dono.
      function addsOwn(key, before, after, id) {
        return key in before || after[key].get('idTime', '') == id;
      }

      // Atleta sem time ('') pode entrar no elenco do dono (aprovação do "Sou jogador").
      allow update: if writable() && keepsEnrollments() && (isAdmin() || isOwnVote()
        || (isPlayers()
          && (ownsTeam(resource.data) || noTeam(resource.data))
          && (ownsTeam(request.resource.data) || noTeam(request.resource.data))
          && ownEnrollmentsOnly())
        || (isPlayers() && joinsOwnedTeam())
        || (isTeamDoc() && signedIn() && resource.data.idDono == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['descricao', 'urlImagem', 'corPrimaria', 'corSecundaria']))
        || partnerUpdate());
      allow delete: if writable() && (isAdmin() || isOwnVote() || (isPlayers() && ownsTeam(resource.data))
        || partnerDelete());
    }

    // Votos de melhor jogador da partida (id do doc = uid de quem votou):
    // leitura pública; cada usuário logado grava só o próprio voto. O admin
    // também grava (migração dos votos antigos).
    match /{collection}/{matchId}/votos/{voterId} {
      function isMatches() {
        return collection.matches('partidas([0-9]{4})?');
      }

      allow read: if isMatches();
      allow create, update: if isMatches() && (isAdmin()
        || (signedIn() && voterId == request.auth.uid
          && request.resource.data.keys().hasOnly(['nome', 'time', 'idTime'])
          && request.resource.data.nome is string && request.resource.data.nome.size() > 0));
      allow delete: if isMatches() && isAdmin();
    }

    // Bolão: palpite de placar (doc id = uid), leitura pública. O dono grava
    // só o placar, o nome e a hora do servidor, enquanto a partida não
    // começou (status manual); o prazo pelo horário a function confere ao
    // pontuar. Pontos (`pontos`/`exato`/`valido`) só as functions gravam.
    match /{collection}/{matchId}/palpites/{uid} {
      function isMatches() {
        return collection.matches('partidas([0-9]{4})?');
      }
      function matchOpen() {
        let status = get(/databases/$(database)/documents/$(collection)/$(matchId)).data.get('status', '');
        return !(status in ['andamento', 'intervalo', 'encerrada']);
      }
      function goals(n) {
        return n is int && n >= 0 && n <= 99;
      }
      function validPrediction() {
        let d = request.resource.data;
        return goals(d.golsCasa) && goals(d.golsFora)
          && d.nome is string && d.nome.size() <= 80
          && d.atualizadoEm == request.time;
      }
      function own() {
        return signedIn() && uid == request.auth.uid && isMatches();
      }

      allow read: if isMatches();
      allow create: if own() && matchOpen() && validPrediction()
        && request.resource.data.keys().hasOnly(['golsCasa', 'golsFora', 'nome', 'atualizadoEm']);
      allow update: if own() && matchOpen() && validPrediction()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['golsCasa', 'golsFora', 'nome', 'atualizadoEm']);
      allow delete: if own() && matchOpen();
    }

    // "Sou jogador": pedido para entrar no elenco de um time (id do doc = uid).
    // O usuário cria, corrige enquanto pendente e reenvia depois de rejeitado
    // ou de removido do elenco,
    // sempre como "pendente" e só com os próprios campos; nunca se autoaprova.
    // O admin lê tudo e responde (aprovar cria o jogador, pelo app).
    match /solicitacoes_jogador/{userId} {
      function isRequester() {
        return signedIn() && userId == request.auth.uid;
      }

      function validSubmit() {
        let data = request.resource.data;
        return data.uid == request.auth.uid
          && data.status == 'pendente'
          && data.keys().hasOnly(['uid', 'nome_usuario', 'email', 'nome', 'time', 'idTime', 'regiao', 'idRegiao', 'temporada',
            'posicao', 'mensagem', 'urlImagem', 'status', 'data', 'atualizado_em', 'idJogadorVinculo',
            'idCampeonato', 'campeonato'])
          // Competição em que quer jogar pelo time (opcional).
          && (!('idCampeonato' in data) || data.idCampeonato is int)
          && (!('campeonato' in data) || (data.campeonato is string && data.campeonato.size() <= 80))
          // Pedido de vínculo: id do atleta (sem conta) que o usuário diz ser.
          && (!('idJogadorVinculo' in data) || (data.idJogadorVinculo is string && data.idJogadorVinculo.size() <= 64))
          && data.nome is string && data.nome.size() >= 3 && data.nome.size() <= 40
          && data.time is string && data.time.size() > 0
          && data.mensagem is string && data.mensagem.size() <= 200;
      }

      // Dono do time do pedido: lê e responde (aprovar/rejeitar/tirar do
      // elenco); nome, time e posição continuam só do admin.
      function isTeamOwner() {
        return ownsTeam(resource.data);
      }

      function ownerAnswer() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'motivo', 'idJogador', 'atualizado_em'])
          && request.resource.data.status in ['aprovada', 'rejeitada', 'removido'];
      }

      allow read: if isRequester() || isAdmin() || isTeamOwner();
      allow create: if isRequester() && validSubmit();
      // Aprovado também pode mandar um pedido novo (outra competição): a
      // inscrição aprovada fica no atleta.
      allow update: if (isRequester() && validSubmit()) || isAdmin()
        || (isTeamOwner() && ownerAnswer());
      allow delete: if (isRequester() && resource.data.status == 'pendente') || isAdmin();
    }

    // "Sou dono de time": pedido para criar o próprio time (id do doc = uid).
    // Mesmas regras do "Sou jogador": o usuário cria/corrige/reenvia como
    // "pendente" com os próprios campos e nunca se aprova. Aprovado, este doc
    // é o registro de dono que `ownedTeam()` consulta (o dono não altera mais).
    match /solicitacoes_time/{userId} {
      function isRequester() {
        return signedIn() && userId == request.auth.uid;
      }

      function validSubmit() {
        let data = request.resource.data;
        return data.uid == request.auth.uid
          && data.status == 'pendente'
          && data.keys().hasOnly(['uid', 'nome_usuario', 'email', 'nome', 'regiao', 'idRegiao', 'descricao', 'urlImagem',
            'corPrimaria', 'corSecundaria', 'contato', 'mensagem', 'temporada', 'status', 'data', 'atualizado_em'])
          && (!('corPrimaria' in data) || (data.corPrimaria is string && data.corPrimaria.size() <= 9))
          && (!('corSecundaria' in data) || (data.corSecundaria is string && data.corSecundaria.size() <= 9))
          && data.nome is string && data.nome.size() >= 3 && data.nome.size() <= 40
          && data.regiao is string && data.regiao.size() > 0
          && data.contato is string && data.contato.size() >= 10 && data.contato.size() <= 30
          && data.descricao is string && data.descricao.size() <= 300
          && data.mensagem is string && data.mensagem.size() <= 200;
      }

      allow read: if isRequester() || isAdmin();
      allow create: if isRequester() && validSubmit();
      allow update: if (isRequester() && resource.data.status != 'aprovada' && validSubmit()) || isAdmin();
      allow delete: if (isRequester() && resource.data.status == 'pendente') || isAdmin();
    }

    // Notícia do parceiro além do limite do dia: espera o admin. O parceiro
    // cria (pendente, dele, na região dele, sem tags reservadas) e lê/apaga as
    // dele; só o admin responde (aprovar publica em `noticias`).
    match /noticias_pendentes/{newsId} {
      function validPending() {
        let p = partner();
        let data = request.resource.data;
        return p != null && p.get('podeNoticias', true)
          && data.get('idAutor', '') == request.auth.uid
          && data.get('idRegiao', '') == p.get('idRegiao', '-')
          && data.get('status', '') == 'pendente'
          && !(data.get('tag', '') in ['gol', 'resultado', 'votacao', 'publicidade'])
          && data.keys().hasOnly(['id', 'data', 'criadoEm', 'status', 'titulo', 'descricao', 'urlImagem', 'link',
            'exibir', 'fk_competicao', 'idRegiao', 'time_casa', 'time_fora', 'gol_time_casa', 'gol_time_fora', 'tag',
            'images', 'idAutor']);
      }

      function isAuthor() {
        return signedIn() && resource.data.get('idAutor', '') == request.auth.uid;
      }

      allow read: if isAuthor() || isAdmin();
      allow create: if validPending();
      allow update: if isAdmin();
      allow delete: if isAuthor() || isAdmin();
    }

    // Pedido "Sou parceiro" (id = uid): o dono cria/corrige/reenvia sempre como
    // pendente, sem as permissões (que só o admin grava); o admin lê e responde.
    // `idsDestaquesVinculo`: destaques sem dono que o usuário diz serem dele; o
    // parceiro aprovado só mexe nessa lista (o vínculo quem grava é o admin).
    match /solicitacoes_parceiro/{userId} {
      function isRequester() {
        return signedIn() && userId == request.auth.uid;
      }

      function validSubmit() {
        let data = request.resource.data;
        return data.uid == request.auth.uid
          && data.status == 'pendente'
          && data.keys().hasOnly(['uid', 'nome_usuario', 'email', 'nome', 'regiao', 'idRegiao', 'contato', 'mensagem',
            'status', 'data', 'atualizado_em', 'idsDestaquesVinculo'])
          && validClaims(data)
          && data.nome is string && data.nome.size() >= 3 && data.nome.size() <= 40
          && data.regiao is string && data.regiao.size() > 0
          && data.contato is string && data.contato.size() >= 10 && data.contato.size() <= 30
          && data.mensagem is string && data.mensagem.size() <= 200;
      }

      function validClaims(data) {
        return !('idsDestaquesVinculo' in data)
          || (data.idsDestaquesVinculo is list && data.idsDestaquesVinculo.size() <= 9);
      }

      allow read: if isRequester() || isAdmin();
      allow create: if isRequester() && validSubmit();
      allow update: if (isRequester() && resource.data.status != 'aprovada' && validSubmit())
        || (isRequester() && validClaims(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['idsDestaquesVinculo', 'atualizado_em']))
        || isAdmin();
      allow delete: if (isRequester() && resource.data.status == 'pendente') || isAdmin();
    }

    // Álbum de figurinhas: catálogo de cada evento (leitura pública, escrita do
    // admin); o álbum da conta só as functions gravam (o dono lê).
    match /album_eventos/{eventId}/figurinhas/{stickerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Ranking de colecionadores do álbum: leitura pública, só as functions gravam.
    match /album_eventos/{eventId}/ranking/{uid} {
      allow read: if true;
      allow write: if false;
    }

    match /usuarios/{userId}/album/{eventId} {
      allow read: if signedIn() && (userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Pacotinho do dia (id `<evento>_<uid>_<a-m-d>`, dia em Brasília): o dono pede
    // só o de hoje, de evento ativo; as functions sorteiam. Um por dia pelo id.
    // Pacotinho: `<evento>_<uid>_<n>`, n = pacotes já abertos + 1 (o mesmo n
    // duas vezes cai no doc que já existe), e só 24 h depois do último pedido
    // (`ultimoPacote`, gravado pelas functions). Não acumula.
    match /album_pacotes/{packId} {
      function packAllowed(eventId) {
        let path = /databases/$(database)/documents/usuarios/$(request.auth.uid)/album/$(eventId);
        let album = exists(path) ? get(path).data : {};
        return packId == eventId + '_' + request.auth.uid + '_' + string(album.get('pacotes', 0) + 1)
          && (!('ultimoPacote' in album) || request.time >= album.ultimoPacote + duration.value(24, 'h'));
      }

      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'idEvento', 'status', 'pedidoEm'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pedido'
        && request.resource.data.pedidoEm == request.time
        && packAllowed(request.resource.data.idEvento)
        && albumOpenFor(get(/databases/$(database)/documents/album_eventos/$(request.resource.data.idEvento)).data);
      allow update, delete: if false;

      // Evento ligado; em teste (`somenteAdmin`), só o admin pede pacote.
      function albumOpenFor(event) {
        return event.ativo == true && (event.get('somenteAdmin', false) != true || isAdmin());
      }
    }

    // Manutenções feitas pelas functions (ex.: `manutencao/recomprimir`): só o
    // admin pede e acompanha.
    match /manutencao/{docId} {
      allow read, write: if isAdmin();
    }

    // Temporada atual e lista do seletor: todo mundo lê (inclusive convidado),
    // só o admin troca (painel "Temporadas").
    match /config/temporadas {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Regras da votação de melhor jogador (mínimo de votos e porcentagem):
    // leitura pública (a apuração roda no app), escrita do admin.
    match /config/votacao {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Notificações push (Cloud Functions em functions/).
    // Liga/desliga por ação: só o admin lê e altera.
    match /config/notificacoes {
      allow read, write: if isAdmin();
    }

    // Histórico de envios: gravado pelas functions (Admin SDK), lido pelo admin.
    match /notificacoes_envios/{logId} {
      allow read: if isAdmin();
    }

    // Aviso manual: o admin só cria; a function envia e registra.
    match /push_avisos/{noticeId} {
      allow create: if isAdmin()
        && request.resource.data.titulo is string && request.resource.data.titulo.size() > 0
        && request.resource.data.titulo.size() <= 80
        && request.resource.data.corpo is string && request.resource.data.corpo.size() > 0
        && request.resource.data.corpo.size() <= 240;
    }
  }
}
