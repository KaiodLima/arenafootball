{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "hosting/public",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/noticia/**",
        "function": {
          "functionId": "sharePage",
          "region": "us-central1"
        }
      },
      {
        "source": "/atleta/**",
        "function": {
          "functionId": "sharePage",
          "region": "us-central1"
        }
      },
      {
        "source": "/destaque/**",
        "function": {
          "functionId": "sharePage",
          "region": "us-central1"
        }
      },
      {
        "source": "/app",
        "function": {
          "functionId": "sharePage",
          "region": "us-central1"
        }
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "src/test",
        "*.log"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ]
}