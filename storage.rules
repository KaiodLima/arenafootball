rules_version = '2';

// Security Rules do Firebase Storage do Arena Football.
// Deploy: firebase deploy --only storage --project arenasoccerflutter
service firebase.storage {
  match /b/{bucket}/o {
    // Imagens do app (StorageFolder em lib/core/services/storage_upload_service.dart).
    // `campeonatos` também aceita o regulamento em PDF.
    match /{folder}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && ((folder in ['noticias', 'destaques', 'times', 'jogadores', 'campeonatos']
            && request.resource.contentType.matches('image/.*'))
          || (folder == 'campeonatos' && request.resource.contentType == 'application/pdf'));
    }
  }
}
